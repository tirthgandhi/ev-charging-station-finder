{
  "name": "ev-charging-station-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "preview": "node scripts/preview.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "test:atlas": "node --env-file-if-exists=.env scripts/test-atlas.js",
    "privacy:check": "node scripts/privacy-check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "mongoose": "^8.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
